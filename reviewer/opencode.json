{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "reviewer *": "allow",
      "ls*": "allow",
      "cat*": "allow"
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  }
}
