{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.6-flash",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "z-ai/glm-5.3-free": {
          "name": "GLM-5.3 Free",
          "limit": {
            "context": 200000,
            "input": 120000,
            "output": 32768
          }
        }
      }
    },
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    }
  },
  "permission": {
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "reviewer *": "allow",
      "ls*": "allow",
      "cat*": "allow"
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
