# Malicious-Dockerfile self-test for builder-manager-mcp.js's git-auth
# secret isolation (see the "Git credential handling" and "Job-pod
# isolation" header comments in scripts/builder-manager-mcp.js).
#
# Proves that a RUN step CANNOT read the pre-flight git-auth secret
# (delivered to `buildctl` as `--secret id=GIT_AUTH_TOKEN,env=GIT_AUTH_TOKEN`)
# by any of:
#   1. The default BuildKit secret mount path (never referenced by this
#      Dockerfile — no `RUN --mount=type=secret` appears below).
#   2. Its own process environment.
#   3. /proc/<pid>/environ of every other process it can see — this is the
#      exfiltration vector this cluster's required
#      `--oci-worker-no-process-sandbox` BUILDKITD_FLAGS specifically opens
#      up (RUN steps do not get their own private PID namespace under that
#      flag), and exactly what the two-container `buildkitd`/`buildctl`
#      pod split in builder-manager-mcp.js exists to close: `buildctl` (the
#      only place the secret's env var is ever set) runs in a completely
#      separate pod container, hence a separate PID namespace, from
#      `buildkitd` (the one with the relaxed sandbox, and the one that
#      actually executes this RUN step).
#
# Invocation: set the `GIT_AUTH_TOKEN` secret fed to buildctl to a REAL
# minted GitHub App installation token (see docs/DEPLOY-ENGINEERING.md's
# "Secret-isolation self-test" runbook) — a working credential is required
# for BuildKit's git source to actually complete the context checkout, so
# the RUN step below gets a chance to execute at all. The canary this RUN
# step searches for is the fixed `ghs_` prefix every such token has — public,
# documented GitHub App-token format, not a secret itself, so it's safe to
# hardcode here. It is deliberately NOT threaded through as a build
# ARG/build-arg: Docker/BuildKit always injects ARG-declared values into the
# RUN step's own process environment regardless of any container boundary,
# which would make this self-test "fail" for a reason that has nothing to do
# with the actual `GIT_AUTH_TOKEN` isolation being tested (an earlier version
# of this fixture made exactly this mistake, using a build-arg-carried
# random marker — see git history — and had to be corrected before its
# result meant anything). The RUN step fails the build (proving a leak) if
# the prefix is found anywhere it inspects; it succeeds (proving isolation
# held) if not.
FROM alpine:3.20
RUN set -eu; \
    canary='ghs_'; \
    leak=0; \
    if [ -e /run/secrets/GIT_AUTH_TOKEN ] && grep -q "$canary" /run/secrets/GIT_AUTH_TOKEN 2>/dev/null; then \
      echo "LEAK vector 1: default secret mount path was populated without an explicit RUN --mount"; leak=1; \
    fi; \
    if env | grep -q "$canary"; then \
      echo "LEAK vector 2: canary present in this RUN step's own environment"; leak=1; \
    fi; \
    for f in /proc/[0-9]*/environ; do \
      if [ -r "$f" ] && tr '\0' '\n' < "$f" 2>/dev/null | grep -q "$canary"; then \
        echo "LEAK vector 3: canary readable via $f (no-process-sandbox /proc exfiltration)"; leak=1; \
      fi; \
    done; \
    if [ "$leak" = "1" ]; then \
      echo "FAIL: git-auth secret canary reachable from a RUN step" >&2; \
      exit 1; \
    fi; \
    echo "OK: git-auth secret canary not reachable from this RUN step (checked default secret mount, own env, and every readable /proc/*/environ)"
CMD ["true"]
