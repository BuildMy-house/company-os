# Build from the repo root with live persona/skills contexts:
# docker build -f company-ops/Dockerfile.engineering \
#   --build-context manager-def=../.claude/agents \
#   --build-context skills-src=../.agents/skills \
#   -t hermes-engineering company-ops
FROM node:22-bookworm-slim

WORKDIR /opt/company-ops

RUN apt-get update \
  && apt-get install -y --no-install-recommends git openssh-client \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code@latest \
  && npm install -g opencode-ai@latest \
  && npm install -g @openai/codex@latest \
  && mkdir -p /opt/company-ops/.claude/agents /opt/company-ops/.claude/skills

COPY --from=manager-def opencode-manager.md /opt/company-ops/.claude/agents/opencode-manager.md
COPY --from=skills-src . /opt/company-ops/.claude/skills/
COPY scripts/engineering-entrypoint.sh /opt/company-ops/scripts/engineering-entrypoint.sh

EXPOSE 8000
ENTRYPOINT ["bash", "/opt/company-ops/scripts/engineering-entrypoint.sh"]
