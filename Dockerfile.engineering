# Build from the company-os root, with the canonical agent-manager prompt
# pulled directly from the buildmy.house/workspace repo as an additional
# build context (Docker 23+/buildx required):
# docker build -f Dockerfile.engineering \
#   --build-context shared=https://github.com/BuildMy-house/workspace.git \
#   -t hermes-engineering .
#
# Also buildable in-cluster via `builder_build_and_push` (see
# scripts/builder-manager-mcp.js and docs/DEPLOY-ENGINEERING.md's
# "Agent-triggered build+push" section): its rootless-BuildKit Job natively
# supports named additional build contexts (the same primitive buildx's
# `--build-context` uses), so the `COPY --from=shared` step below resolves
# there too — pass `contexts: { shared:
# "https://github.com/BuildMy-house/workspace.git#<40-hex-sha>" }` alongside
# `dockerfile_path: "Dockerfile.engineering"`. (This was previously a
# documented gap under the prior Kaniko-based builder, which only supported
# a single `--context` — now resolved in the builder mechanism itself.)
#
# Verified live 2026-09-29: the rootless-BuildKit-Job mechanism and its
# named-additional-context resolution (this exact `COPY --from=shared`
# pattern) against two pinned commits of a PUBLIC repo (see
# Dockerfile.buildkit-selftest). The private GitHub-App-token path is now
# verified for company-os; the full private workspace named-context build
# remains a separate end-to-end verification item. Routine builds still use
# the in-cluster BuildKit tool, never a build inside an agent container.
FROM node:22-bookworm-slim

ARG AGENT_FLAVOR=claude
ARG INSTALL_BROWSER=true
ENV AGENT_FLAVOR=${AGENT_FLAVOR}

WORKDIR /opt/company-ops

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates openssh-client \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g opencode-ai@latest ai-cli-mcp@latest \
  && if [ "$AGENT_FLAVOR" = "claude" ]; then \
       npm install -g @anthropic-ai/claude-code@latest @openai/codex@latest; \
     fi \
  && mkdir -p /root/.config/ai-cli \
  && if [ "$AGENT_FLAVOR" = "claude" ]; then \
       codex mcp add ai-cli-mcp -- npx -y ai-cli-mcp@latest; \
       mkdir -p /opt/company-ops/.claude/agents; \
       mv "$(command -v claude)" /usr/local/bin/claude-real; \
       printf '#!/bin/sh\nexec /usr/local/bin/claude-real --autocompact 200k --disallowed-tools Agent "$@"\n' > /usr/local/bin/claude; \
       chmod 755 /usr/local/bin/claude; \
     fi \
  && mkdir -p /opt/company-ops/.claude/agents /opt/company-ops/.claude/skills /opt/company-ops/.config/opencode

# Headless Chromium for screenshot capability AND the app repo's Playwright e2e
# suite (run by the pre-push hook): installed as root at build time into a
# shared, persistent path (/opt/ms-playwright, not /tmp or $HOME) so the
# unprivileged engineering user can launch it at runtime without sudo and no
# session has to re-download it. `--with-deps` installs the Chromium system
# libraries (glib, nss, atk, cups, drm, xkb, ...) via apt, which needs root and
# is therefore impossible at runtime; without them every e2e test fails with
# "libglib-2.0.so.0: cannot open shared object file" and pushes needed
# `--no-verify`. Chromium only to keep image size down. A rootless launch
# smoke test at the end of this file fails the build if any lib is missing.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright
RUN if [ "$INSTALL_BROWSER" = "true" ]; then \
      npm install -g playwright \
      && npx playwright install --with-deps chromium \
      && chown -R 1001:1001 /opt/ms-playwright; \
    else \
      echo "[browser] skipped for slim agent image"; \
    fi
# Global npm modules aren't requirable by default; NODE_PATH makes
# require('playwright') work for agent scripts without local installs.
ENV NODE_PATH=/usr/local/lib/node_modules

RUN useradd --create-home --uid 1001 --shell /bin/bash engineering \
  && mkdir -p /workspace \
  && chown -R engineering:engineering /opt/company-ops /workspace /home/engineering

# Canonical agent-manager body lives once in buildmy.house/workspace's
# .agents/agent-manager.md — pulled live from the remote at build time so
# there is no hand-maintained copy of it inside company-os. Concatenated
# with a small container-only supplement (self-upgrade, reporting to
# Hermes) that has no equivalent outside the container.
COPY --from=shared .agents/agent-manager.md /opt/company-ops/agent-config/canonical-agent-manager.md
COPY hermes-engineering/container-workspace/manager-supplement.md /opt/company-ops/agent-config/manager-supplement.md
RUN cat /opt/company-ops/agent-config/canonical-agent-manager.md \
        /opt/company-ops/agent-config/manager-supplement.md \
        > /opt/company-ops/.claude/agents/agent-manager.md
COPY hermes-engineering/container-workspace/AGENTS.md /opt/company-ops/workspace-root/AGENTS.md
COPY hermes-engineering/container-workspace/AGENTS_STEWARD.md /opt/company-ops/workspace-root/AGENTS_STEWARD.md
COPY hermes-engineering/container-workspace/HIVE_WORKER_MEMORY.md /opt/company-ops/scripts/HIVE_WORKER_MEMORY.md
COPY hermes-operations/shared/.opencode/skills /opt/company-ops/.claude/skills/
COPY agent-config /opt/company-ops/agent-config
COPY scripts/github-app-token.js /opt/company-ops/scripts/github-app-token.js
COPY scripts/fetch-infisical-secrets.js /opt/company-ops/scripts/fetch-infisical-secrets.js
COPY scripts/generate-agent-mcp-config.js /opt/company-ops/scripts/generate-agent-mcp-config.js
COPY scripts/ai-cli-mcp-policy.js /opt/company-ops/scripts/ai-cli-mcp-policy.js
COPY scripts/sync-repo.sh /opt/company-ops/scripts/sync-repo.sh
COPY scripts/stall-watch.sh /opt/company-ops/scripts/stall-watch.sh
COPY scripts/engineering-manager-mcp.js /opt/company-ops/scripts/engineering-manager-mcp.js
COPY scripts/container-manager-mcp.js /opt/company-ops/scripts/container-manager-mcp.js
COPY scripts/hive-member-mcp.js /opt/company-ops/scripts/hive-member-mcp.js
COPY scripts/registry-manager-mcp.js /opt/company-ops/scripts/registry-manager-mcp.js
COPY scripts/hermes-messenger-mcp.js /opt/company-ops/scripts/hermes-messenger-mcp.js
COPY scripts/builder-manager-mcp.js /opt/company-ops/scripts/builder-manager-mcp.js
COPY scripts/check-advertised-mcp-tools.js /opt/company-ops/scripts/check-advertised-mcp-tools.js
COPY scripts/engineering-entrypoint.sh /opt/company-ops/scripts/engineering-entrypoint.sh
COPY scripts/opencode-plugins/axiom-usage.js /opt/company-ops/scripts/opencode-plugins/axiom-usage.js

ENV HOME=/home/engineering
USER engineering

# Build-time e2e smoke test, run as the unprivileged user (no root, no
# --no-verify): launch Chromium, load a data: URL, assert the title.
RUN if [ "$INSTALL_BROWSER" = "true" ]; then \
      npx playwright install --dry-run chromium \
      && node -e "const {chromium}=require('playwright');(async()=>{const b=await chromium.launch();const p=await b.newPage();await p.goto('data:text/html,<title>e2e-ok</title>');const t=await p.title();await b.close();if(t!=='e2e-ok'){console.error('bad title',t);process.exit(1)}console.log('playwright smoke ok:',t)})().catch(e=>{console.error(e);process.exit(1)})"; \
    fi

EXPOSE 8000 8001
ENTRYPOINT ["bash", "/opt/company-ops/scripts/engineering-entrypoint.sh"]
