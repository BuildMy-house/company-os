# Marketing-lead agent image: the engineering OpenCode image plus the marketing-lead tooling.
#
# Build the base first (docs/IMAGES.md), then, from the company-os root:
#   docker build -f Dockerfile.engineering --build-arg AGENT_FLAVOR=opencode \
#     --build-arg INSTALL_BROWSER=false --build-context shared=<workspace repo/commit> -t engineering-opencode .
#   docker build -f Dockerfile.marketing-lead --build-arg BASE_IMAGE=engineering-opencode -t marketing-lead .
# In-cluster: builder_build_and_push with dockerfile_path "Dockerfile.marketing-lead" and
# build_args {BASE_IMAGE: "<registry>/company-os-engineering-opencode@sha256:<digest>"}.
# No browser is installed; pin BASE_IMAGE by digest.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

USER root

# substack-mcp is NOT an official Substack API (it drives the web endpoints with a session
# cookie). Pinned to 1.3.2, whose npm gitHead is c148a3b176997077d2796530ae98660ef2f96d5a and
# whose src/ was diffed identical to that reviewed commit. Never `npx substack-mcp@latest`.
# The tarball integrity is checked before install; bumping needs a new review + new hash.
ARG SUBSTACK_MCP_VERSION=1.3.2
ARG SUBSTACK_MCP_INTEGRITY=sha512-+NvSHlI6ErEjzmIXhzrZKxj6e1an7DuP4th5eaaJcvpGI0nSv3Rh62JBTDXDdbGdYMfDSBxSNWB7gomY3THfIA==

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 python3-venv postgresql-client openssl \
  && rm -rf /var/lib/apt/lists/* \
  && cd /tmp && npm pack "substack-mcp@${SUBSTACK_MCP_VERSION}" --silent \
  && test "sha512-$(openssl dgst -sha512 -binary substack-mcp-${SUBSTACK_MCP_VERSION}.tgz | openssl base64 -A)" = "${SUBSTACK_MCP_INTEGRITY}" \
  && npm install -g "/tmp/substack-mcp-${SUBSTACK_MCP_VERSION}.tgz" \
  && rm -f /tmp/substack-mcp-*.tgz

# company_ops (ingester, sidecar, bridge) in its own venv, same path the CronJob uses.
COPY pyproject.toml /opt/company-ops-src/pyproject.toml
COPY company_ops /opt/company-ops-src/company_ops
RUN python3 -m venv /opt/company-ops-venv \
  && /opt/company-ops-venv/bin/pip install --no-cache-dir /opt/company-ops-src \
  && rm -rf /opt/company-ops-src

# No inherited engineering skills: the marketing-lead gets only its own.
RUN rm -rf /opt/company-ops/.claude/skills/* /opt/company-ops/.claude/agents/*

COPY marketing-lead/lib /opt/marketing-lead/lib
COPY marketing-lead/bin /opt/marketing-lead/bin
COPY marketing-lead/hooks /opt/marketing-lead/hooks
COPY marketing-lead/config /opt/marketing-lead/config
COPY marketing-lead/skills /opt/marketing-lead/skills
COPY marketing-lead/memory /opt/marketing-lead/memory
COPY marketing-lead/package.json /opt/marketing-lead/package.json
COPY marketing-lead/AGENTS.md marketing-lead/opencode.json /opt/marketing-lead/
COPY marketing-lead/gitconfig /etc/gitconfig
COPY marketing-lead/HIVE_WORKER_MEMORY.md /opt/company-ops/scripts/HIVE_WORKER_MEMORY.md
COPY scripts/marketing-lead-entrypoint.sh /opt/company-ops/scripts/marketing-lead-entrypoint.sh

# Guarded git first on PATH; real git stays at /usr/bin/git (the wrapper's default).
RUN ln -sf /opt/marketing-lead/bin/git /usr/local/bin/git \
  && ln -sf /opt/marketing-lead/bin/marketing-lead /usr/local/bin/marketing-lead \
  && chmod 755 /opt/marketing-lead/bin/* /opt/marketing-lead/hooks/* /opt/company-ops/scripts/marketing-lead-entrypoint.sh \
  && mkdir -p /var/lib/marketing-lead /workspace \
  && chown -R engineering:engineering /var/lib/marketing-lead /workspace

ENV AGENT_FLAVOR=opencode \
    RUNNER_AGENT=opencode \
    MARKETING_LEAD_ALLOWED_REMOTES=https://github.com/BuildMy-house/website,https://github.com/BuildMy-house/hermees-diary,https://github.com/BuildMy-house/observer-website

USER engineering
ENTRYPOINT ["bash", "/opt/company-ops/scripts/marketing-lead-entrypoint.sh"]
