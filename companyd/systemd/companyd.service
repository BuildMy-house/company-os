[Unit]
Description=companyd — autonomous multi-generation deployment daemon
Documentation=https://github.com/nahar/house_designer/blob/main/docs/COMPANYD.md
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/nahar/Documents/code/house_designer/company-ops/companyd/companyd.py --daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/companyd /var/run /var/log/companyd /company
PrivateTmp=yes

# Environment
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
