{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "compaction": {"auto": true, "prune": true, "reserved": 20000},
  "provider": {
    "opencode": {"models": {
      "mimo-v2.6-flash-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}},
      "mimo-v2.5-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}}
    }}
  },
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "{env:STEWARD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:STEWARD_TOKEN}"
      }
    },
    "axiom": {
      "type": "remote",
      "url": "https://mcp.axiom.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:AXIOM_QUERY_TOKEN}",
        "x-axiom-org-id": "{env:AXIOM_ORG_ID}"
      }
    },
    "infisical": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "--legacy-peer-deps",
        "@infisical/mcp"
      ],
      "environment": {
        "INFISICAL_HOST_URL": "{env:INFISICAL_HOST_URL}",
        "INFISICAL_AUTH_METHOD": "{env:INFISICAL_AUTH_METHOD}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_ID}",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "{env:INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET}"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ]
}
