{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "https://buildmyhouse.stewardacs.xyz/mcp/sse",
      "headers": {
        "Authorization": "Bearer {env:STEWARD_TOKEN}"
      }
    },
    "axiom": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-server-axiom"
      ],
      "environment": {
        "AXIOM_TOKEN": "{env:AXIOM_TOKEN}",
        "AXIOM_ORG_ID": "{env:AXIOM_ORG_ID}",
        "AXIOM_URL": "{env:AXIOM_URL}"
      }
    }
  },
  "instructions": ["/workspace/house_designer/site-homely/AGENTS.md"]
}
