{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.6-flash-free",
  "compaction": {"auto": true, "prune": true, "reserved": 20000},
  "provider": {
    "opencode": {"models": {
      "mimo-v2.6-flash-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}},
      "mimo-v2.5-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}}
    }},
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "{env:ZAI_CODING_PLAN_API_KEY}"
      },
      "models": {
        "glm-5.3-flash": {"name": "GLM-5.3 Flash", "limit": {"context": 1000000, "input": 120000, "output": 131072}}
      }
    }
  },
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "{env:STEWARD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:STEWARD_TOKEN}"
      }
    },
    "axiom": {
      "type": "remote",
      "url": "https://mcp.axiom.co/mcp",
      "headers": {
        "Authorization": "Bearer {env:AXIOM_QUERY_TOKEN}",
        "x-axiom-org-id": "{env:AXIOM_ORG_ID}"
      }
    }
  },
  "instructions": ["AGENTS.md"]
}
