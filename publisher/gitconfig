# Installed as /etc/gitconfig. The git wrapper (/usr/local/bin/git) also injects core.hooksPath,
# so the agent's -c overrides cannot disable the pre-push hook.
[user]
	name = buildmy.house publisher
	email = publisher@buildmy.house
[core]
	hooksPath = /opt/publisher/hooks
[credential "https://github.com"]
	helper = /opt/publisher/bin/git-credential-publisher
[push]
	default = nothing
[init]
	defaultBranch = main
