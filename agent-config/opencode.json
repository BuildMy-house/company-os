{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "compaction": {"auto": true, "prune": true, "reserved": 20000},
  "provider": {
    "opencode": {"models": {
      "mimo-v2.6-flash-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}},
      "mimo-v2.5-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}}
    }}
  },
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "{env:STEWARD_MCP_URL}",
      "headers": {"Authorization": "Bearer {env:STEWARD_TOKEN}"}
    }
  },
  "instructions": ["AGENTS.md"],
  "plugin": ["/opt/company-ops/scripts/opencode-plugins/axiom-usage.js"]
}
