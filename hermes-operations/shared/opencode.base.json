{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "compaction": {"auto": true, "prune": true, "reserved": 20000},
  "provider": {
    "opencode": {"models": {
      "mimo-v2.6-flash-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}},
      "mimo-v2.5-free": {"limit": {"context": 200000, "input": 120000, "output": 32000}}
    }},
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "mimo-v2.5-free": {"name": "MiMo-V2.5 Free", "limit": {"context": 200000, "input": 120000, "output": 32000}},
        "z-ai/glm-5.3-flash": {"name": "GLM 5.3 Flash", "limit": {"context": 1000000, "input": 120000, "output": 131072}}
      }
    }
  },
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "{env:STEWARD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:STEWARD_TOKEN}"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "instructions": [
    "AGENTS.md"
  ]
}
