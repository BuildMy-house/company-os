[Unit]
Description=companyd MCP Server
After=companyd.service
Requires=companyd.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python3 /opt/homely/companyd_mcp_server.py --port 8001
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

Environment="MCP_PORT=8001"
Environment="SOCKET_PATH=/var/run/companyd.sock"

[Install]
WantedBy=multi-user.target
