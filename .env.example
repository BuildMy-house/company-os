COMPANY_OPS_TELEMETRY=telemetry.jsonl
GITHUB_REPOSITORY=owner/house-designer-ops
GITHUB_BACKUP_BRANCH=backups/agent
R2_ENDPOINT=
R2_BUCKET=homely-company
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# number of most recent daily backups to retain in R2; older ones are deleted
R2_BACKUP_KEEP_LAST=30
SLACK_WEBHOOK_URL=
HERMES_COMMAND=hermes
CLAUDE_COMMAND=claude
# Engineering-manager container headless Claude CLI auth: use an API key, or
# CLAUDE_CODE_OAUTH_TOKEN minted with `claude setup-token` for subscription billing.
ANTHROPIC_API_KEY=
OPENCODE_COMMAND=opencode
OPENCODE_ZEN_API_KEY=
TOKENROUTER_API_KEY=
NOUS_API_KEY=
HERMES_MODEL=tencent/hy3:free
AGENT_MODEL=tokenrouter/z-ai/glm-5.3-flash
# Hermes CEO Discord bridge (discord_bridge.py) — bot logs in with token
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_ALLOW_ALL_USERS=
DISCORD_WORKER_CONFIG=mcp-workers.json
DISCORD_WORKER=hermes
DISCORD_TASK_TYPE=policy
DISCORD_TIMEOUT=180
DISCORD_ANNOUNCE_CHANNEL=
# Human Interface outbound channel (#hil in buildmy.house server, P2-J)
DISCORD_HIL_CHANNEL=
# Previously used for human_interface.py DM delivery; retained for discord_bridge DM flows
DISCORD_DM_USER=
DISCORD_DAILY_PROMPT=
DISCORD_INVESTOR_PROMPT=
DISCORD_QUESTIONS_PROMPT=
DISCORD_INTERVAL_DAILY=86400
DISCORD_INTERVAL_INVESTOR=86400
# Future provider swap: Nous Research model/provider goes here later.
# Postgres — production passwords (generate with: python3 -c "import secrets; print(secrets.token_urlsafe(20))")
POSTGRES_PASSWORD=
COMPANY_PASSWORD=
OBSERVER_PASSWORD=
ANALYTICS_PASSWORD=

# Postgres connection strings — three roles enforce a trust boundary between
# company ops, observer writes, and analytics reads (same DB, different creds).
# Dev/test: local docker via scripts/test-db-up.sh.
COMPANY_DATABASE_URL=postgresql://hermes_company:${COMPANY_PASSWORD}@postgres:5432/homely_company
OBSERVER_DATABASE_URL=postgresql://hermes_observer_writer:${OBSERVER_PASSWORD}@postgres:5432/homely_company
ANALYTICS_DATABASE_URL=postgresql://hermes_analytics:${ANALYTICS_PASSWORD}@postgres:5432/homely_company

# Axiom — query/read-side token for `company-ops telemetry-query` (company_ops/axiom_client.py).
# This is a DIFFERENT, read-scoped token from the app's own write-only ingest
# token (homely/.env.example's VITE_AXIOM_TOKEN) — do not reuse one for the other.
AXIOM_TOKEN=
AXIOM_DATASET=homely-telemetry
AXIOM_ENDPOINT=https://api.axiom.co
