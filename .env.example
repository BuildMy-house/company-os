# ═══════════════════════════════════════════════════════════════════════════
# INFISICAL SECRETS — single source of truth
# ═══════════════════════════════════════════════════════════════════════════
#
# Every secret below is stored in Infisical and injected at runtime — never
# commit real values here. Inventory, gap list, and the new-host bootstrap
# procedure: docs/SECRETS-INFISICAL.md
#
#   - Kubernetes: Infisical Secrets Operator syncs them into k8s Secrets
#     (k8s/infisical-sync.yaml); workloads read them via envFrom.
#   - Local/docker: entrypoints fetch them via scripts/fetch-infisical-secrets.js
#     when the bootstrap identity below is set; otherwise this file (ignored
#     copy: .env) is sourced.
#
# The ONLY manually provisioned secret on a new host is the Infisical
# bootstrap machine identity (Universal Auth).

# ───────────────────────────────────────────────────────────────────────────
# BOOTSTRAP IDENTITY (authenticates TO Infisical; not stored in Infisical)
# Seeded into k8s Secret `infisical-bootstrap-credentials` (keys: clientId,
# clientSecret) by scripts/bootstrap-secrets.sh.
# ───────────────────────────────────────────────────────────────────────────
INFISICAL_HOST_URL=https://eu.infisical.com
INFISICAL_UNIVERSAL_AUTH_CLIENT_ID=
INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET=
INFISICAL_ENV=dev
# "Build My house" project id (matches k8s/infisical-sync.yaml)
INFISICAL_PROJECT_ID=8806c2b0-73d2-4bea-8537-5b874c5ff592
INFISICAL_SECRET_PATH=/

# ───────────────────────────────────────────────────────────────────────────
# HERMES TIER — Infisical path: /hermes
# Hermes gateway + company_ops runtime (Postgres, Discord, models)
# ───────────────────────────────────────────────────────────────────────────

# Discord bot integration (hermes-agent native gateway + human_interface.py)
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=
DISCORD_ALLOWED_CHANNELS=
DISCORD_ALLOW_ALL_USERS=
DISCORD_HOME_CHANNEL=
DISCORD_ANNOUNCE_CHANNEL=
DISCORD_BLOG_CHANNEL=
DISCORD_HIL_CHANNEL=
DISCORD_FINANCE_CHANNEL=
DISCORD_DM_USER=

# Models
NOUS_API_KEY=
HERMES_MODEL=tencent/hy3:free

# Postgres roles + connection strings (three roles enforce the trust boundary)
POSTGRES_PASSWORD=
COMPANY_PASSWORD=
OBSERVER_PASSWORD=
ANALYTICS_PASSWORD=
COMPANY_DATABASE_URL=
OBSERVER_DATABASE_URL=
ANALYTICS_DATABASE_URL=
# PM store — GAP: pending import into Infisical /hermes (docs/SECRETS-INFISICAL.md)
PM_DATABASE_URL=

# Axiom query/read side (company_ops/axiom_client.py) — GAP: pending import
AXIOM_DATASET=
AXIOM_ENDPOINT=

# ───────────────────────────────────────────────────────────────────────────
# INFRA TIER — Infisical path: /infra
# Engineering containers + infrastructure automation only
# ───────────────────────────────────────────────────────────────────────────

# GitHub App auth (the only path used — engineering-entrypoint.sh always mints
# a fresh installation token via github-app-token.js; GITHUB_APP_PRIVATE_KEY
# carries the PEM inline, same content as certs/buildmyhouse-engineering-app.pem)
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_REPOSITORY=BuildMy-house/house-designer-ops
GITHUB_BACKUP_BRANCH=backups/agent

# Hermes API server bearer token (hermes-messenger-mcp.js <-> hermes-gateway)
API_SERVER_KEY=

# LLM providers
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY — optional fallback, forwarded by engineering-entrypoint.sh
# when set; not currently stored in Infisical
ANTHROPIC_API_KEY=
OPENCODE_GO_API_KEY=
ZAI_CODING_PLAN_API_KEY=
TOKENROUTER_API_KEY=
HERMES_COMMAND=hermes
CLAUDE_COMMAND=claude
OPENCODE_COMMAND=opencode
AGENT_MODEL=tokenrouter/z-ai/glm-5.3-free

# Cloudflare R2 backups (pg-backup.sh, git-backup.sh)
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_API_TOKEN=
R2_BACKUP_KEEP_LAST=7

# Cloudflare / Neon infra ops
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NEON_API_KEY=

# Steward ACS
STEWARD_TOKEN=
STEWARD_URL=

# Axiom org-wide tokens
AXIOM_TOKEN=
AXIOM_ORG_ID=
AXIOM_DASHBOARD_TOKEN=
VITE_AXIOM_TOKEN=

# ───────────────────────────────────────────────────────────────────────────
# SHARED — Infisical path: /
# buildmy.house MCP test account (AGENTS.md contract; same content as
# certs/buildmyhouse-test-account.env)
# ───────────────────────────────────────────────────────────────────────────
BUILDMYHOUSE_APP_URL=https://app.buildmy.house
BUILDMYHOUSE_MCP_URL=https://app.buildmy.house/mcp
BUILDMYHOUSE_MCP_BEARER_TOKEN=
BUILDMYHOUSE_TEST_EMAIL=
BUILDMYHOUSE_TEST_PASSWORD=

# ───────────────────────────────────────────────────────────────────────────
# LOCAL CONFIG (non-secret)
# ───────────────────────────────────────────────────────────────────────────
COMPANY_OPS_TELEMETRY=telemetry.jsonl
