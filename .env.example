# ═══════════════════════════════════════════════════════════════════════════
# INFISICAL SECRETS INJECTION
# ═══════════════════════════════════════════════════════════════════════════
#
# All secrets below are injected at container runtime via Infisical.
# Set INFISICAL_TOKEN as an environment variable when starting the container:
#
#   INFISICAL_TOKEN=<workspace-token> docker compose up
#
# Entrypoint scripts (scripts/entrypoint.sh, scripts/engineering-entrypoint.sh)
# will fetch secrets from Infisical and inject them into the environment
# before the actual application starts.
#
# For local development without Infisical, populate this file manually with
# real values (never commit to version control).

# ───────────────────────────────────────────────────────────────────────────
# TIER 1: HERMES-READABLE SECRETS
# Infisical path: /secrets/hermes/*
# Accessible by: Hermes gateway container, company-ops agent
# ───────────────────────────────────────────────────────────────────────────

# Discord Bot Integration
# DISCORD_BOT_TOKEN — Injected via Infisical at /secrets/hermes/discord_bot_token
DISCORD_BOT_TOKEN=
# DISCORD_ALLOWED_USERS — CSV of Discord user IDs allowed to use Hermes; Injected via Infisical
DISCORD_ALLOWED_USERS=
# DISCORD_ALLOWED_CHANNELS — CSV of Discord channel IDs Hermes can access; Injected via Infisical
DISCORD_ALLOWED_CHANNELS=
# DISCORD_ALLOW_ALL_USERS — Allow all Discord users to use Hermes (override ALLOWED_USERS)
DISCORD_ALLOW_ALL_USERS=
# Discord-Hermes configuration
DISCORD_WORKER_CONFIG=mcp-workers.json
DISCORD_WORKER=hermes
DISCORD_TASK_TYPE=policy
DISCORD_TIMEOUT=180
# DISCORD_ANNOUNCE_CHANNEL — Channel ID for Hermes announcements; Injected via Infisical
DISCORD_ANNOUNCE_CHANNEL=
# DISCORD_HIL_CHANNEL — Human Interface outbound channel (#hil in buildmy.house server, P2-J); Injected via Infisical
DISCORD_HIL_CHANNEL=
# DISCORD_FINANCE_CHANNEL — Financial requests & approvals (#finance in buildmy.house server, P3-J/P8-A); Injected via Infisical
DISCORD_FINANCE_CHANNEL=
# DISCORD_DM_USER — Legacy: previously used for human_interface.py DM delivery; Injected via Infisical
DISCORD_DM_USER=
# DISCORD_DAILY_PROMPT — Daily recurring Hermes prompt; Injected via Infisical
DISCORD_DAILY_PROMPT=
# DISCORD_INVESTOR_PROMPT — Investor-mode Hermes prompt; Injected via Infisical
DISCORD_INVESTOR_PROMPT=
# DISCORD_QUESTIONS_PROMPT — Q&A Hermes prompt; Injected via Infisical
DISCORD_QUESTIONS_PROMPT=
DISCORD_INTERVAL_DAILY=86400
DISCORD_INTERVAL_INVESTOR=86400

# LLM Model Providers
# NOUS_API_KEY — Nous Research API key for Hermes model inference; Injected via Infisical
NOUS_API_KEY=
HERMES_MODEL=tencent/hy3:free

# Postgres Database Credentials
# POSTGRES_PASSWORD — Root postgres user password; Injected via Infisical
POSTGRES_PASSWORD=
# COMPANY_PASSWORD — Hermes company operations role password; Injected via Infisical
COMPANY_PASSWORD=
# OBSERVER_PASSWORD — Analytics observer writer role password; Injected via Infisical
OBSERVER_PASSWORD=
# ANALYTICS_PASSWORD — Analytics read-only role password; Injected via Infisical
ANALYTICS_PASSWORD=

# Postgres Connection Strings — three roles enforce trust boundary
# Dev/test: local docker via scripts/test-db-up.sh
COMPANY_DATABASE_URL=postgresql://hermes_company:${COMPANY_PASSWORD}@postgres:5432/homely_company
OBSERVER_DATABASE_URL=postgresql://hermes_observer_writer:${OBSERVER_PASSWORD}@postgres:5432/homely_company
ANALYTICS_DATABASE_URL=postgresql://hermes_analytics:${ANALYTICS_PASSWORD}@postgres:5432/homely_company

# ───────────────────────────────────────────────────────────────────────────
# TIER 2: INFRA-ONLY SECRETS
# Infisical path: /secrets/infra/*
# Accessible by: Engineering container, infrastructure automation only
# NOT accessible by: Hermes gateway container
# ───────────────────────────────────────────────────────────────────────────

# GitHub Credentials
# GitHub App auth (GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY) is the
# only path used — engineering-entrypoint.sh always mints a fresh installation token from it
# via github-app-token.js and never reads a pre-set GITHUB_TOKEN, so there's no PAT fallback.
GITHUB_REPOSITORY=BuildMy-house/house-designer-ops
GITHUB_BACKUP_BRANCH=backups/agent

# Backup & Storage (Cloudflare R2 / S3-compatible)
# INFISICAL_TOKEN — Workspace token for Infisical secret injection (required to use this infrastructure); provided at runtime
# NOT stored in Infisical itself — must be set via environment when starting container
# Example: INFISICAL_TOKEN=<workspace-machine-identity-token> docker compose up
INFISICAL_TOKEN=

# R2_ENDPOINT — S3-compatible endpoint for Cloudflare R2; Injected via Infisical
R2_ENDPOINT=
# R2_BUCKET — Bucket name for company ops backups
R2_BUCKET=homely-company
# R2_ACCESS_KEY_ID — R2 API token access key ID; Injected via Infisical
R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY — R2 API token secret; Injected via Infisical
R2_SECRET_ACCESS_KEY=
# Number of most recent daily backups to retain in R2; older ones are deleted (~1 week retention)
R2_BACKUP_KEEP_LAST=7

# LLM & Engineering (Model Selection & Delegation)
HERMES_COMMAND=hermes
CLAUDE_COMMAND=claude
OPENCODE_COMMAND=opencode
AGENT_MODEL=tokenrouter/z-ai/glm-5.3-free

# Anthropic Claude API (Engineering Container)
# ANTHROPIC_API_KEY — Claude API key for engineering-manager headless CLI; OR use CLAUDE_CODE_OAUTH_TOKEN
# Injected via Infisical
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN — OAuth token from `claude setup-token` (alternative to ANTHROPIC_API_KEY)
# Used for subscription billing. Injected via Infisical
CLAUDE_CODE_OAUTH_TOKEN=

# LLM Provider APIs (Engineering Container)
# OPENCODE_GO_API_KEY — OpenCode Go provider API key (not OpenCode Zen); Injected via Infisical
OPENCODE_GO_API_KEY=
# ZAI_CODING_PLAN_API_KEY — Z.AI Coding Plan subscription key, used for glm-5.3-flash; Injected via Infisical
ZAI_CODING_PLAN_API_KEY=
# TOKENROUTER_API_KEY — Token Router model aggregation API key. FREE TIER — this is a no-cost
# provider (e.g. z-ai/glm-5.3-free); prefer it over paid/quota-limited providers whenever a
# task can plausibly use it. Injected via Infisical
TOKENROUTER_API_KEY=

# Telemetry & Observability
COMPANY_OPS_TELEMETRY=telemetry.jsonl

# Axiom Analytics
# Query/read-side credentials for `company-ops telemetry-query` (company_ops/axiom_client.py)
# and the `axiom` MCP server (mcp-server-axiom across Claude, Codex, OpenCode, Hermes).
# NOTE: This is DIFFERENT from the app's write-only ingest token (homely/.env.example's VITE_AXIOM_TOKEN).
# Do not reuse one for the other.
# AXIOM_TOKEN — Axiom analytics API token (read-only, query-scoped); Injected via Infisical
AXIOM_TOKEN=
# AXIOM_ORG_ID — Axiom organization ID; Injected via Infisical
AXIOM_ORG_ID=
AXIOM_URL=https://api.axiom.co
AXIOM_DATASET=homely-telemetry
AXIOM_ENDPOINT=https://api.axiom.co
