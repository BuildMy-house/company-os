#!/bin/sh
# Git credential helper: supplies GITHUB_TOKEN for github.com over https only; never stores or prints it elsewhere.
[ "$1" = "get" ] || exit 0
host=""
while IFS='=' read -r k v; do [ -z "$k" ] && break; [ "$k" = "host" ] && host="$v"; done
[ "$host" = "github.com" ] && [ -n "$GITHUB_TOKEN" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$GITHUB_TOKEN"
