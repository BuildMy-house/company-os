{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/mimo-v2.5-free",
  "provider": {
    "tokenrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "TokenRouter",
      "options": {
        "baseURL": "https://api.tokenrouter.com/v1",
        "apiKey": "{env:TOKENROUTER_API_KEY}"
      },
      "models": {
        "mimo-v2.5-free": {"name": "MiMo-V2.5 Free"},
        "z-ai/glm-5.3-flash": {"name": "GLM 5.3 Flash"}
      }
    }
  },
  "mcp": {
    "steward": {
      "type": "remote",
      "url": "{env:STEWARD_MCP_URL}",
      "headers": {
        "Authorization": "Bearer {env:STEWARD_TOKEN}"
      }
    }
  },
  "plugin": [
    ".opencode/plugins/graphify.js"
  ],
  "instructions": [
    "AGENTS.md",
    "AGENTS_STEWARD.md"
  ]
}
